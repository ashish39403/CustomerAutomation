# Public configuration. The only value baked into the frontend bundle.
#
# Leave empty to use same-origin requests:
#   - dev:   Vite proxies /api -> http://127.0.0.1:8000 (no CORS needed)
#   - prod:  the built app is served by FastAPI itself
#
# To call a backend on another origin, set an absolute URL, e.g.
#   VITE_API_URL=http://localhost:8000
# (the backend must then allow CORS with credentials).
VITE_API_URL=
